# This is an example .env file.
# Copy this file to .env and fill in your actual credentials and configurations.
# Lines starting with # are comments.

# --- API Football Configuration ---
# Get your key from https://www.api-football.com/
API_FOOTBALL_KEY=your_api_football_v3_key
# API_FOOTBALL_URL=https://v3.football.api-sports.io # Default, uncomment to override

# --- CalDAV Configuration ---
# URL to your CalDAV server, often includes username and password directly for basic auth
# or points to the DAV endpoint if using token/app password.
# Example for Nextcloud/Baikal: https://your.davserver.com/remote.php/dav
# Example with basic auth (not recommended if token auth is available):
# CALDAV_URL=https://username:password@your.davserver.com/remote.php/dav/calendars/username/calendar_name/
CALDAV_URL=https://your_caldav_server_url/path/to/calendar/
CALDAV_USERNAME=your_caldav_username # Required if not in URL and server needs auth
CALDAV_PASSWORD=your_caldav_password # Required if not in URL and server needs auth
# CALDAV_CALENDAR_NAME=Football # Optional: specify if URL doesn't point to a specific calendar or if you need to select among multiple

# --- LLM Configuration ---
LLM_PROVIDER=openai # Currently 'openai' is the primary example. Could be 'anthropic', 'google', 'local_ollama' etc. in future.
LLM_API_KEY=your_openai_api_key # Or API key for other provider
LLM_MODEL=gpt-3.5-turbo # e.g., gpt-3.5-turbo, gpt-4, claude-2, etc.

# --- File Paths ---
# Paths are relative to the project root directory (where main.py and Dockerfile are)
# These defaults assume system_prompt.txt and blacklist.json are in the project root.
SYSTEM_PROMPT_FILE_PATH=system_prompt.txt
BLACKLIST_FILE_PATH=blacklist.json

# --- Logging Configuration ---
LOG_LEVEL=INFO # DEBUG, INFO, WARNING, ERROR, CRITICAL

# --- League Fetching Strategy ---
# Option 1: Whitelist Mode (Recommended for focused suggestions)
# If WHITELIST_MODE_LEAGUE_IDS is set, the service will ONLY fetch games from these leagues.
# Provide a comma-separated list of league IDs.
# Example (Top 5 Euro leagues, UCL, UEL, UCoL, Libertadores, Sudamericana, World Cup, Euros, AFCON, Asian Cup, Club WC - VERIFY IDs WITH YOUR API KEY):
# WHITELIST_MODE_LEAGUE_IDS=39,140,135,78,61,2,3,848,13,11,1,4,6,5,17
# (Leave empty or comment out to not use whitelist mode)
WHITELIST_MODE_LEAGUE_IDS=

# Option 2: Specific League Mode (Use if WHITELIST_MODE_LEAGUE_IDS is not set)
# If WHITELIST_MODE_LEAGUE_IDS is empty/unset, and TARGET_LEAGUE_ID is set,
# only games from this league will be fetched.
TARGET_LEAGUE_ID=
# TARGET_SEASON is rarely needed if fetching by date range for an active league.
# The API usually infers the current season. Only set if you have a specific old season in mind for a league.
# Example: TARGET_SEASON=2022 for league ID 39 would target the 2022-2023 Premier League season.
TARGET_SEASON=

# Option 3: Broad Mode (Use if both WHITELIST_MODE_LEAGUE_IDS and TARGET_LEAGUE_ID are not set)
# Fetches games from all leagues available via your API plan for the configured date range.
# This can be a very large number of games and may hit API rate limits or process slowly.

# --- Date Range for Fetching Upcoming Games ---
FETCH_DAYS_AHEAD=7 # Number of days from today to fetch fixtures for.
